{
  "info": {
    "name": "Spring Auth Server",
    "description": "Coleção completa — fluxo iOS (telefone + UUID), fluxo legado (e-mail + senha + JWT), apostas (bets) e participantes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080", "type": "string" },
    { "key": "token",         "value": "", "type": "string",   "description": "JWT token — preenchido pelo script do login legado." },
    { "key": "userId",        "value": "1", "type": "string" },
    { "key": "phone",         "value": "11999999999", "type": "string" },
    { "key": "uuid",          "value": "uuid-dispositivo-teste", "type": "string" },
    { "key": "code",          "value": "123456", "type": "string" },
    { "key": "betId",         "value": "1", "type": "string" },
    { "key": "eventId",       "value": "1", "type": "string" },
    { "key": "participantId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "📱 Usuários — Fluxo iOS (Telefone + UUID)",
      "item": [
        {
          "name": "1. Login por Telefone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"uuid\": \"{{uuid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 200 → usuário já cadastrado. HTTP 202 → código gerado no log (FakeSms)."
          }
        },
        {
          "name": "2. Confirmar Código",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/confirm", "host": ["{{baseUrl}}"], "path": ["users","confirm"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"uuid\": \"{{uuid}}\",\n  \"code\": \"{{code}}\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 200 → cria/atualiza usuário. HTTP 404 → sem código pendente. HTTP 400 → código inválido ou expirado."
          }
        },
        {
          "name": "3. Login Direto (após cadastro)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"uuid\": \"{{uuid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 200 direto — sem pedir código novamente."
          }
        },
        {
          "name": "4. Atualizar Perfil (iOS)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ricardo\",\n  \"description\": \"Atleta e desenvolvedor\",\n  \"phone\": null,\n  \"photoUrl\": null\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 200 → BackendUserResponse atualizado."
          }
        }
      ]
    },
    {
      "name": "🔐 Usuários — Fluxo Legado (E-mail + Senha + JWT)",
      "item": [
        {
          "name": "Criar Usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario@email.com\",\n  \"password\": \"Senha@123\",\n  \"name\": \"Nome do Usuário\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 201 → usuário criado com role USER."
          }
        },
        {
          "name": "Login (e-mail + senha)",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.token) { pm.collectionVariables.set('token', res.token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@authserver.com\",\n  \"password\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 200 → { token, user }. Token salvo automaticamente na variável {{token}}."
          }
        },
        {
          "name": "Listar Usuários (ativos)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }, "description": "Usuários ativos em ordem alfabética. Público." }
        },
        {
          "name": "Listar Usuários por Role",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users?role=ADMIN", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "role", "value": "ADMIN" }] } }
        },
        {
          "name": "Buscar Usuário por ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}"] }, "description": "Retorna UserResponse compatível com app iOS." }
        },
        {
          "name": "Atualizar Nome do Usuário (legado)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Nome\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Adicionar Role ao Usuário",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}/roles/ADMIN", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}","roles","ADMIN"] }
          }
        },
        {
          "name": "Remover Usuário",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users","{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "🏷️ Roles",
      "item": [
        {
          "name": "Criar Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"MODERATOR\",\n  \"description\": \"Moderador de conteúdo\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 201 → role criada. Requer ADMIN."
          }
        },
        {
          "name": "Listar Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          }
        }
      ]
    },
    {
      "name": "🥊 Apostas (Bets)",
      "description": "Gerenciamento de apostas entre atletas. Todos os endpoints são públicos.",
      "item": [
        {
          "name": "Listar Apostas",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/bets", "host": ["{{baseUrl}}"], "path": ["bets"] }, "description": "Lista apostas ordenadas por createdAt DESC. Apostas expiradas são atualizadas automaticamente." }
        },
        {
          "name": "Buscar Aposta por ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/bets/{{betId}}", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}"] }, "description": "HTTP 200 → BetResponse. HTTP 404 → não encontrada." }
        },
        {
          "name": "Criar Aposta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets", "host": ["{{baseUrl}}"], "path": ["bets"] },
            "body": { "mode": "raw", "raw": "{\n  \"createdByUserId\": \"1\",\n  \"athleteAUserId\": \"2\",\n  \"athleteBUserId\": \"3\",\n  \"wodTitle\": \"Fran 21-15-9\",\n  \"prizeType\": \"gatorade\",\n  \"prizeOtherDescription\": null,\n  \"expiresAt\": \"2026-12-31T23:59:00Z\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "HTTP 201 → BetResponse.\nprizeType: water | gatorade | beer | shake | other\nSe prizeType=other, prizeOtherDescription obrigatório.\nexpiresAt deve ser futuro."
          }
        },
        {
          "name": "Propor Vencedor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/winner", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","winner"] },
            "body": { "mode": "raw", "raw": "{\n  \"requesterUserId\": \"1\",\n  \"proposedWinnerUserId\": \"2\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Apenas criador ou atletas. Não permitido em apostas finished/canceled/expired."
          }
        },
        {
          "name": "Confirmar Vencedor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/confirm", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","confirm"] },
            "body": { "mode": "raw", "raw": "{\n  \"confirmerUserId\": \"2\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Apenas atletas A ou B. Ambos confirmados → status=finished."
          }
        },
        {
          "name": "Rejeitar Vencedor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/reject", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"rejectorUserId\": \"2\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Apenas atletas. status=disputed. Limpa proposedWinnerUserId e confirmações."
          }
        },
        {
          "name": "Cancelar Aposta",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/cancel", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"requesterUserId\": \"1\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Apenas o criador. Não permitido se já finished/canceled/expired."
          }
        },
        {
          "name": "Atualizar Resultado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/result", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","result"] },
            "body": { "mode": "raw", "raw": "{\n  \"requesterUserId\": \"1\",\n  \"athleteAResult\": \"5:30\",\n  \"athleteBResult\": \"6:10\",\n  \"winnerUserId\": \"2\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Criador ou atletas. winnerUserId deve ser atleta A ou B. status=finished."
          }
        },
        {
          "name": "Votar em Atleta",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bets/{{betId}}/vote", "host": ["{{baseUrl}}"], "path": ["bets","{{betId}}","vote"] },
            "body": { "mode": "raw", "raw": "{\n  \"voterUserId\": \"1\",\n  \"votedAthleteUserId\": \"2\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Apenas em apostas open ou disputed. Substitui voto anterior se já existir. Retorna votesByUserId atualizado."
          }
        }
      ]
    },
    {
      "name": "📅 Eventos",
      "item": [
        {
          "name": "Criar Evento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Java Summit 2026\",\n  \"description\": \"Conferência sobre Java e JVM\",\n  \"location\": \"Curitiba, PR\",\n  \"eventDate\": \"2026-09-15T09:00:00\",\n  \"status\": \"SCHEDULED\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Listar Eventos", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] } } },
        {
          "name": "Listar Eventos com Filtros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?name=java&status=SCHEDULED&sortBy=eventDate&direction=ASC",
              "host": ["{{baseUrl}}"], "path": ["events"],
              "query": [
                { "key": "name", "value": "java" }, { "key": "status", "value": "SCHEDULED" },
                { "key": "location", "value": "curitiba", "disabled": true },
                { "key": "startDate", "value": "2026-01-01T00:00:00", "disabled": true },
                { "key": "endDate", "value": "2026-12-31T23:59:59", "disabled": true },
                { "key": "sortBy", "value": "eventDate" }, { "key": "direction", "value": "ASC" }
              ]
            }
          }
        },
        { "name": "Buscar Evento por ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] } } },
        {
          "name": "Atualizar Evento",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Nome do Evento\",\n  \"location\": \"São Paulo, SP\",\n  \"status\": \"CANCELLED\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Remover Evento",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] } }
        },
        {
          "name": "Associar Participante ao Evento",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/events/{{eventId}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","participants","{{participantId}}"] } }
        },
        {
          "name": "Remover Participante do Evento",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/events/{{eventId}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","participants","{{participantId}}"] } }
        },
        { "name": "Listar Participantes do Evento", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/events/{{eventId}}/participants", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","participants"] } } }
      ]
    },
    {
      "name": "👥 Participantes",
      "item": [
        {
          "name": "Criar Participante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/participants", "host": ["{{baseUrl}}"], "path": ["participants"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"phone\": \"(41) 99999-0000\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Listar Participantes", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/participants", "host": ["{{baseUrl}}"], "path": ["participants"] } } },
        { "name": "Buscar Participante por ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants","{{participantId}}"] } } },
        {
          "name": "Atualizar Participante",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants","{{participantId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"João Santos\",\n  \"phone\": \"(41) 98888-1111\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Remover Participante",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants","{{participantId}}"] } }
        }
      ]
    }
  ]
}
